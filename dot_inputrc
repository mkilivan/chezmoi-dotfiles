# Readline config (bash line editing) — managed by chezmoi.
# Brings over the zsh line-editing behaviour from dot_zshrc.

# Keep the system defaults (Home/End, Delete, etc.)
$include /etc/inputrc

set editing-mode emacs

# Up/Down search history for lines starting with what's already typed
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Completion: case-insensitive, treat - and _ alike, list on first Tab,
# then cycle through matches on further Tabs (Shift-Tab goes back)
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set menu-complete-display-prefix on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on
TAB: menu-complete
"\e[Z": menu-complete-backward

# Ctrl-W deletes one path component ("bar" from "/foo/bar"), like
# WORDCHARS='' in zsh. Needs the tty's own Ctrl-W binding turned off.
set bind-tty-special-chars off
"\C-w": unix-filename-rubout
